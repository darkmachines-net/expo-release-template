{
  "schemaVersion": 3,
  "repository": "example/expo-app",
  "defaultBranch": "main",
  "install": [
    [
      "npm",
      "ci"
    ]
  ],
  "metadataFiles": [
    "app.json"
  ],
  "profiles": {
    "beta": {
      "environment": "preview",
      "approvalEnvironment": "beta",
      "channel": "beta",
      "easProfile": "beta",
      "submit": false
    },
    "production": {
      "environment": "production",
      "approvalEnvironment": "production",
      "channel": "production",
      "easProfile": "production",
      "submit": false
    }
  },
  "mobile": {
    "directory": ".",
    "versionFloor": "0.0.0",
    "inputs": [
      "index.js",
      "app",
      "assets",
      "package.json",
      "package-lock.json",
      "app.config.js"
    ],
    "projectId": "12345678-1234-1234-1234-123456789012",
    "owner": "example",
    "slug": "expo-app",
    "targets": [
      {
        "id": "android",
        "platform": "android",
        "applicationId": "example.expo.app",
        "buildNumberFloor": 0
      }
    ]
  },
  "hooks": {
    "prepare": [
      "node",
      "release-hooks.mjs"
    ]
  },
  "development": {
    "easProfile": "development",
    "environment": "preview",
    "approvalEnvironment": "beta",
    "platforms": [
      "android"
    ],
    "publicEnvironment": {
      "EXPO_RELEASE_VARIANT": "development"
    }
  }
}
